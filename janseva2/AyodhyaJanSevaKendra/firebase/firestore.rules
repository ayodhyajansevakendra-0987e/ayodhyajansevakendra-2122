rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && userDoc().data.role == "admin";
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // A customer can create only a customer profile. Admin role must be assigned
      // by a trusted operator in Firebase Console or a trusted server.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == "customer";
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
      allow delete: if isAdmin();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /applications/{id} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.keys().hasAll(["customerId","customerName","phone","serviceId","serviceName","details","status","createdAt","updatedAt"]);
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /payments/{id} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      // Client may create only pending payment intent. Only trusted backend/webhook
      // should ever mark a payment verified.
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
